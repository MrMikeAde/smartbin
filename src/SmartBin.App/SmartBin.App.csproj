<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework Condition="'$(OS)' == 'Windows_NT'">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT'">net10.0</TargetFramework>
    <TargetPlatformMinVersion Condition="'$(OS)' == 'Windows_NT'">10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyTitle>SmartBin</AssemblyTitle>
    <Product>SmartBin Adaptive Storage Protection Utility</Product>
    <Version>1.0.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Authors>SmartBin Engineering Team</Authors>
    <Company>SmartBin Project</Company>
    <Description>Adaptive storage protection and intelligent lossless compression utility for recoverable deleted data.</Description>

    <UseWinUI Condition="'$(OS)' == 'Windows_NT'">true</UseWinUI>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(OS)' == 'Windows_NT' And '$(Platform)' == 'ARM64'">win10-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(OS)' == 'Windows_NT' And '$(Platform)' != 'ARM64'">win10-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- Production Release Optimizations -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DefineConstants>TRACE;RELEASE</DefineConstants>
  </PropertyGroup>

  <!-- Conditional compile constants for Windows -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <!-- Conditional compilation items for Windows -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.241114003" />
  </ItemGroup>

  <!-- Conditional items for non-Windows (e.g. Linux sandbox) to prevent build failures -->
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <Compile Remove="App.xaml.cs" />
    <Compile Remove="MainWindow.xaml.cs" />
    <None Include="App.xaml.cs" />
    <None Include="MainWindow.xaml.cs" />
    <Page Remove="**\*.xaml" />
    <ApplicationDefinition Remove="**\*.xaml" />
    <None Include="**\*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartBin.Core\SmartBin.Core.csproj" />
    <ProjectReference Include="..\SmartBin.Infrastructure\SmartBin.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
  </ItemGroup>
</Project>
