<Window
    x:Class="SmartBin.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2000/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2000/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SmartBin Dashboard">

    <Grid Padding="24" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header and Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="SmartBin Dashboard" Style="{ThemeResource HeaderTextBlockStyle}" FontWeight="SemiBold"/>
                <TextBlock Text="Experimental Adaptive Recycle Bin PoC with Storage Intelligence" Style="{ThemeResource BodyTextBlockStyle}" Foreground="Gray"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button x:Name="ImportBtn" Content="Import File..." Click="OnImportFileClicked" Style="{StaticResource AccentButtonStyle}"/>
                <Button x:Name="AnalyzeStorageBtn" Content="Analyze Storage" Click="OnAnalyzeStorageClicked"/>
                <Button x:Name="OptimizeNowBtn" Content="Optimize Now" Click="OnOptimizeNowClicked"/>
                <Button x:Name="RestoreBtn" Content="Restore Selected" Click="OnRestoreSelectedClicked"/>
            </StackPanel>
        </Grid>

        <!-- Main Dashboard View -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Summary & Metrics -->
            <StackPanel Grid.Column="0" Spacing="16" Margin="0,0,16,0">

                <!-- Storage Pressure Simulator Panel -->
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Storage Pressure Simulator" Style="{ThemeResource SubheaderTextBlockStyle}" FontWeight="Medium"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="SimStateCombo" Grid.Column="0" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="Normal"/>
                                <ComboBoxItem Content="Low"/>
                                <ComboBoxItem Content="Critical"/>
                            </ComboBox>
                            <ToggleSwitch x:Name="SimToggle" Grid.Column="1" Header="Simulation" OnContent="On" OffContent="Off" Toggled="OnSimulationToggled"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Storage Visualization -->
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Storage Visualization" Style="{ThemeResource SubheaderTextBlockStyle}" FontWeight="Medium"/>
                        <ProgressBar x:Name="StorageProgress" Value="0" Minimum="0" Maximum="100" Height="12" CornerRadius="4"/>
                        <TextBlock x:Name="StorageStatusText" Text="Loading storage status..." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="Gray"/>
                    </StackPanel>
                </Border>

                <!-- Detailed Stats Card -->
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="System Metrics" Style="{ThemeResource SubheaderTextBlockStyle}" FontWeight="Medium"/>
                        <MenuFlyoutSeparator Margin="0,4"/>

                        <Grid>
                            <TextBlock Text="Original size:" Style="{ThemeResource BodyTextBlockStyle}"/>
                            <TextBlock x:Name="OriginalSizeText" Text="0 bytes" HorizontalAlignment="Right" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="Bold"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Stored size:" Style="{ThemeResource BodyTextBlockStyle}"/>
                            <TextBlock x:Name="StoredSizeText" Text="0 bytes" HorizontalAlignment="Right" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="Bold"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Actual space reclaimed:" Style="{ThemeResource BodyTextBlockStyle}"/>
                            <TextBlock x:Name="SpaceSavedText" Text="0 bytes" HorizontalAlignment="Right" Style="{ThemeResource BodyTextBlockStyle}" Foreground="Green" FontWeight="Bold"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Potential recovery:" Style="{ThemeResource BodyTextBlockStyle}"/>
                            <TextBlock x:Name="PotentialSavedText" Text="0 bytes" HorizontalAlignment="Right" Style="{ThemeResource BodyTextBlockStyle}" Foreground="Green"/>
                        </Grid>

                        <MenuFlyoutSeparator Margin="0,4"/>

                        <Grid>
                            <TextBlock Text="Files protected:" Style="{ThemeResource BodyTextBlockStyle}"/>
                            <TextBlock x:Name="FilesProtectedText" Text="0" HorizontalAlignment="Right" Style="{ThemeResource BodyTextBlockStyle}"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Compressed:" Style="{ThemeResource BodyTextBlockStyle}"/>
                            <TextBlock x:Name="CompressedText" Text="0" HorizontalAlignment="Right" Style="{ThemeResource BodyTextBlockStyle}"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Already optimized:" Style="{ThemeResource BodyTextBlockStyle}"/>
                            <TextBlock x:Name="OptimizedText" Text="0" HorizontalAlignment="Right" Style="{ThemeResource BodyTextBlockStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Operation Terminal -->
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Operation Terminal" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="Bold" Foreground="Gray"/>
                        <ScrollViewer Height="100" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TerminalText" Text="Terminal Ready..." TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Foreground="DarkGreen"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right Panel: Items pivot tab separating SmartBin, Windows Recycle Bin, and Controlled Experiment -->
            <Pivot Grid.Column="1" Margin="8,0,0,0">

                <!-- Tab 1: SmartBin Controlled Items -->
                <PivotItem Header="SmartBin Storage">
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="SmartBin Recoverable Items" Style="{ThemeResource SubheaderTextBlockStyle}" FontWeight="Medium" Margin="0,0,0,12"/>

                            <ListView x:Name="ItemsListView" Grid.Row="1" SelectionMode="Single" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SelectionChanged="OnItemsSelectionChanged">
                                <ListView.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid Padding="12,0" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Filename" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="Orig Size" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="2" Text="Stored Size" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="3" Text="Status" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="4" Text="SHA-256 Hash" FontWeight="Bold"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.HeaderTemplate>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="12,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding OriginalFileName}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding OriginalSize}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding CurrentStoredSize}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding CompressionStatus}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Sha256Hash}" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </PivotItem>

                <!-- Tab 2: Windows Recycle Bin Integration -->
                <PivotItem Header="Windows Recycle Bin">
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <TextBlock Text="Windows Recycle Bin Items" Style="{ThemeResource SubheaderTextBlockStyle}" FontWeight="Medium"/>
                                    <Border Background="Orange" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="READ-ONLY INTEGRATION" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                    <TextBlock x:Name="WinStatsText" Text="Loading..." VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                    <Button x:Name="RefreshWinBtn" Content="Refresh Bin" Click="OnRefreshWinClicked"/>
                                </StackPanel>
                            </Grid>

                            <ListView x:Name="WinItemsListView" Grid.Row="1" SelectionMode="Single" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SelectionChanged="OnWinItemsSelectionChanged">
                                <ListView.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid Padding="12,0" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Filename" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="Size" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="2" Text="Volume" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="3" Text="Date Deleted" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="4" Text="Original Location" FontWeight="Bold"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.HeaderTemplate>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="12,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Size}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Volume}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding DeletedTimestamp}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding OriginalPath}" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </PivotItem>

                <!-- NEW: Tab 3: Controlled Experiment Panel (Phase 5) -->
                <PivotItem Header="Controlled Experiment">
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Controlled Real-World Optimization Proof" Style="{ThemeResource SubheaderTextBlockStyle}" FontWeight="Bold" Grid.Column="0"/>
                                    <Border Background="Red" CornerRadius="4" Padding="6,2" Grid.Column="1">
                                        <TextBlock Text="CONTROLLED EXPERIMENT ONLY" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="SmartBin can safely run a multi-phase verification test on exactly ONE selected Windows Recycle Bin item. No background or batch optimization occurs." Style="{ThemeResource BodyTextBlockStyle}" Foreground="Gray"/>
                                <MenuFlyoutSeparator/>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Selected Item Details -->
                                    <StackPanel Grid.Column="0" Spacing="8">
                                        <TextBlock Text="Selected Target File" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ExpFileNameText" Text="[No Windows Recycle Bin item selected]" Style="{ThemeResource TitleTextBlockStyle}"/>
                                        <TextBlock x:Name="ExpOrigPathText" Text="Original Path: -" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="Gray"/>
                                        <TextBlock x:Name="ExpSizeText" Text="Original Size: -" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="Gray"/>
                                        <Button x:Name="StartExpBtn" Content="Begin Controlled Test" Click="OnBeginControlledTestClicked" Style="{StaticResource AccentButtonStyle}" Margin="0,12,0,0" HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <!-- Pipeline Safety Indicators Checklist -->
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock Text="Pipeline Safety Verification Checklist" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold"/>
                                        <Grid>
                                            <TextBlock Text="• Item Identified" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                            <TextBlock x:Name="Check1" Text="PENDING" HorizontalAlignment="Right" Foreground="Gray" FontWeight="Bold"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="• Content Acquired Safely" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                            <TextBlock x:Name="Check2" Text="PENDING" HorizontalAlignment="Right" Foreground="Gray" FontWeight="Bold"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="• SHA-256 Calculated" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                            <TextBlock x:Name="Check3" Text="PENDING" HorizontalAlignment="Right" Foreground="Gray" FontWeight="Bold"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="• Compression Completed" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                            <TextBlock x:Name="Check4" Text="PENDING" HorizontalAlignment="Right" Foreground="Gray" FontWeight="Bold"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="• Compressed Verified (Decompress &amp; Match Hash)" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                            <TextBlock x:Name="Check5" Text="PENDING" HorizontalAlignment="Right" Foreground="Gray" FontWeight="Bold"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="• Restoration Dry-Run Verified" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                            <TextBlock x:Name="Check6" Text="PENDING" HorizontalAlignment="Right" Foreground="Gray" FontWeight="Bold"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <MenuFlyoutSeparator/>

                                <!-- Commit Boundary -->
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Commit Decision Boundary" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CommitStatusText" Text="Status: WAITING FOR PIPELINE CHECKS" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="Bold" Foreground="DarkBlue"/>
                                    <CheckBox x:Name="MutationCheck" Content="Execute Windows Mutation (Permanently remove original Recycle Bin item after successful verification)"/>
                                    <TextBlock Text="Warning: Windows mutation will invoke a supported COM Shell API action to remove the original item. If mutation is unsupported/unchecked, the verified compressed representation is preserved inside SmartBin, and the Recycle Bin item is untouched." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="DarkRed" TextWrapping="Wrap"/>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="CommitExpBtn" Grid.Column="0" Content="Commit Controlled Experiment" Click="OnCommitExperimentClicked" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" HorizontalAlignment="Stretch"/>
                                        <Button x:Name="KeepCopyBtn" Grid.Column="1" Content="Keep SmartBin Copy (No Mutation)" Click="OnKeepCopyClicked" IsEnabled="False" HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </PivotItem>
            </Pivot>
        </Grid>
    </Grid>
</Window>
